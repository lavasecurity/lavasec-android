<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- API 28 only: the legacy FingerprintManager availability probe needs USE_FINGERPRINT;
         API 29+ uses USE_BIOMETRIC. -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scan a filter-share QR code during import. The image is decoded on-device and never
         leaves the phone; the permission is only requested when the user chooses that method. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Requesting CAMERA implicitly declares the camera features as required, so Play can still
         filter the app off camera-less devices unless the implied features are explicitly optional.
         camera.any does not cover the implied camera/autofocus pair. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <queries>
        <!-- Enumerate only public installed system speech services; never request voice data. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application
        android:name=".LavasecApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lavasec"
        android:usesCleartextTraffic="false">
        <provider
            android:name=".files.LocalLogExportFileProvider"
            android:authorities="${applicationId}.local-log-export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/local_log_export_paths" />
        </provider>
        <!-- Writable target for the camera capture used by the QR import flow. The file is a
             transient cache entry the decoder reads once; nothing is shared beyond the camera. -->
        <provider
            android:name=".files.FilterQrCaptureFileProvider"
            android:authorities="${applicationId}.camera"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/camera_paths" />
        </provider>
        <!-- Recipient-facing PNG exports grant read access to one private cached card only. -->
        <provider
            android:name=".files.FilterShareCardFileProvider"
            android:authorities="${applicationId}.filter-card"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filter_card_paths" />
        </provider>
        <!-- WorkManager initializes on demand through Application only after credential unlock. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>
        <receiver
            android:name=".work.ActivityRetentionUnlockReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>
        <!-- The validator finishes after RN handoff. Let its successor own the task
             identity so a repeated link launches the validator again. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:relinquishTaskIdentity="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${lavaDeepLinkScheme}" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="lavasecurity.app"
                    android:pathPrefix="/app/" />
            </intent-filter>
        </activity>
        <!-- RN foreground; MainActivity retains validated deep links and native flows. -->
        <activity
            android:name=".reactnative.LavaReactActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
