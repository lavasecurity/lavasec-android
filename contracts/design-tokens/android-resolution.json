  "androidOnly": {
    "dynamicColor": "Disabled by default; Android 12+ users may opt in without changing Lava semantic status colors.",
    "errorRole": "Material light error #B3261E is used for normal-size error text; the pinned danger token remains the semantic danger color.",
    "motion": "Animator duration scale is observed and exposed through LocalLavaReducedMotion; explicit app/test override wins.",
    "semanticIcons": "Native project-owned Material-style vectors replace SF Symbols by semantic role.",
    "shapeFamily": "All five Material 3 shape roles resolve to pinned Lava radii; no baseline 4dp or 28dp corners remain.",
    "typographyFallback": "sans-serif-rounded is preferred, with native sans-serif as the OEM fallback.",
    "surfaceFamily": "Every Material 3 surface/elevation, inverse, fixed accent, and active-outline role resolves to the pinned Lava palette; no baseline purple-neutral defaults remain."
  },
  "approvedDeviations": [
    {
      "id": "DS-ANDROID-001",
      "area": "icons",
      "reason": "SF Symbols are Apple-proprietary; Android uses project-owned native vectors with identical semantic roles."
    },
    {
      "id": "DS-ANDROID-002",
      "area": "dynamic-color",
      "reason": "Material dynamic color is opt-in on API 31+ while product status semantics remain pinned."
    },
    {
      "id": "DS-ANDROID-003",
      "area": "error",
      "reason": "The light Material error role is darker than brand danger red to meet 4.5:1 text contrast."
    },
    {
      "id": "DS-ANDROID-004",
      "area": "typography",
      "reason": "OEM font availability requires a rounded-system to system-sans fallback chain."
    }
  ]
